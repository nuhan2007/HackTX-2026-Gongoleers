{
  "name": "myta-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build -c vite.content.config.ts && node scripts/finalize-manifest.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "evaluate": "tsx tools/evaluate.ts",
    "leak-eval": "tsx eval/leakEval.ts",
    "postinstall": "node scripts/fetch-assets.mjs",
    "demo": "vite ../demo --port 5174"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
